# Local development environment (server/config/env.ts loads this via `dotenv/config`). This file
# is for LOCAL DEV ONLY — see .env.production.example for what production (Railway) needs; the
# two are intentionally separate rather than one file with commented-out alternatives, so it's
# never ambiguous which set of values a given environment is actually using.

# GEMINI_API_KEY: optional. Enables certificate OCR + AI-assisted authenticity scoring in
# Achievements / Review & Verify. Leave unset to run with that feature in its no-op fallback mode
# (everything else works normally). Get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=""

# RESEND_API_KEY: optional. Enables outgoing email (registration/approval/reminder/password-reset).
# Leave unset to have emails logged instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="UniHack Ledger <onboarding@resend.dev>"

# Base URL used to build links inside outgoing emails.
APP_URL="http://localhost:3000"

# Backend / PostgreSQL local development — a NATIVE Postgres install (Homebrew: `brew install
# postgresql@16`), not Docker. Role `unihack` / database `unihack_ledger` must exist on it; see
# README "Local development" for the exact `createuser`/`createdb` commands.
DATABASE_URL="postgresql://unihack:unihack_local_password@127.0.0.1:5432/unihack_ledger"
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"
# Use a long random value: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-secret"
