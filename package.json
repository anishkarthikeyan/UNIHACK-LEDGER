{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "api": "tsx server/index.ts",
    "api:dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "db:up": "brew services start postgresql@16",
    "db:down": "echo 'Native Postgres (postgresql@16) is a shared service used by other local projects too — not stopped automatically. Run `brew services stop postgresql@16` yourself if you really want it off.'",
    "db:migrate": "tsx database/migrate.ts",
    "db:import:competitions": "tsx database/import-competitions.ts",
    "db:seed:users": "tsx database/seed-institutional-users.ts",
    "db:import:students": "tsx database/import-students.ts",
    "db:seed:test-staff": "tsx database/seed-test-staff.ts",
    "db:seed:demo": "tsx database/seed-test-staff.ts && tsx database/seed-demo.ts",
    "db:reset:demo": "tsx database/reset-demo.ts --yes",
    "build": "vite build",
    "build:mobile": "node scripts/verify-mobile-api-url.mjs && vite build && npx cap sync",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.8",
    "recharts": "^3.9.2",
    "resend": "^6.18.1",
    "tsx": "^4.21.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
