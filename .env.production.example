# Production environment variables — Railway service ("unihack-ledger-api").
#
# This file is documentation only; it is never loaded by the app (dotenv only reads .env — see
# server/config/env.ts) and contains no real secrets. Set these as actual Railway service
# variables (Railway dashboard → service → Variables, or `railway variables set KEY=value`), not
# as a committed file — that's the whole point of keeping dev (.env, gitignored) and production
# (Railway's own variable store) separate instead of one shared file.

# --- Required ---

# Provided automatically once a Postgres plugin is attached to this service in the same Railway
# project — reference it as ${{Postgres.DATABASE_URL}} rather than typing a literal value, so it
# stays correct if the database is ever moved/recreated.
DATABASE_URL="${{Postgres.DATABASE_URL}}"

# Long random value, DIFFERENT from the one in your local .env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

NODE_ENV="production"

# Comma-separated list of every origin allowed to call this API. A Capacitor mobile app's WebView
# sends one of these as its Origin header (not the API's own URL) — both platform defaults are
# needed unless capacitor.config.ts's androidScheme/iosScheme are customized:
#   https://localhost      (Android — Capacitor's default WebView origin)
#   capacitor://localhost  (iOS — Capacitor's default WebView origin)
# Add your deployed web frontend's real origin too, if you have one.
WEB_ORIGIN="https://localhost,capacitor://localhost"

# Base URL used inside outgoing emails (e.g. "View pipeline" links). Set to your real API's public
# URL, or your web frontend's URL if you deploy one separately.
APP_URL="https://<your-service>.up.railway.app"

# NOT set here: PORT. Railway injects PORT itself at runtime — server/index.ts already prefers
# process.env.PORT over API_PORT when present (see server/config/env.ts), so nothing to configure.

# --- Optional integrations (same as local — see .env.example) ---
GEMINI_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="UniHack Ledger <onboarding@resend.dev>"
FIREBASE_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# --- File storage ---
# Railway's filesystem is ephemeral by default (wiped on every redeploy) — attach a Railway
# Volume to this service (dashboard → service → Settings → Volumes) and point STORAGE_DIR at its
# mount path, or every uploaded certificate is lost on the next deploy.
STORAGE_DIR="/data/uploads"
